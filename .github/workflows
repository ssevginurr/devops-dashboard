name: DevOps Dashboard CI/CD

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      # 2. Docker Hub'a Giriş Yap
      - name: Docker Hub Giris
        uses: docker/login-action@v2
        with:
          username: ${{ secrets.DOCKER_USERNAME }}
          password: ${{ secrets.DOCKER_PASSWORD }}

      # 3. Image oluştur ve yükle
      - name: Build & Push
        uses: docker/build-push-action@v4
        with:
          context: .
          push: true
          tags: ${{ secrets.DOCKER_USERNAME }}/devops-dashboard:latest

      # 4. Sunucuya bağlan ve güncelle
      - name: Deploy to Server
        uses: appleboy/ssh-action@master
        with:
          host: ${{ secrets.HOST }}
          username: root
          key: ${{ secrets.KEY }}
          script: |
            # Varsa eski konteyneri durdur ve sil
            docker stop panel || true
            docker rm panel || true
            
            # Yeni imajı çek
            docker pull ${{ secrets.DOCKER_USERNAME }}/devops-dashboard:latest
            
            # Yeni konteyneri ayağa kaldır
            docker run -d --name panel -p 80:80 --restart unless-stopped ${{ secrets.DOCKER_USERNAME }}/devops-dashboard:latest
            
            # Sunucuda yer kaplamaması için eski/kullanılmayan imajları temizle
            docker image prune -f